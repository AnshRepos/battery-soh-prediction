@startuml RBM_Buffering
!theme plain

participant SC_1412_ADISS as ADISS
participant SC_1420_SDS_RDC as RDC
participant SC_1430_SDSOM as SDSOM
participant rbm_api_interface as RBM

== RBM_StartBuffering : ADISS ==

ADISS -> RBM: RBM_GetVersion()
RBM --> ADISS: Version Info()
ADISS -> RBM: RBM_GetState()
RBM --> ADISS: RBM_Buffering()
ADISS -> RBM: RBM_ReqCbk()
RBM --> ADISS: Callback(RBM_StorSize)
ADISS -> RBM: RBM_AddMetaData()
RBM --> ADISS: RBM_Ok()
ADISS -> RBM: RBM_CleanPartition()
RBM --> ADISS: RBM_Ok()
ADISS -> RBM: RBM_DeleteEntryADISS()
RBM --> ADISS: RBM_Ok()
ADISS -> RBM: RBM_trigSingleEvtRecADISS(timeOfActivation, priority, preEventTime, postEventTime, listofPDUs, TriggerHandle, metadata, euuid, callback)
RBM --> ADISS: RBM_Ok()
RBM --> ADISS: Callback(RBM_TriggerStateChange: RBM_PreEvent)
RBM --> ADISS: Callback(RBM_TriggerStateChange: RBM_PostEvent)
RBM --> ADISS: Callback(RBM_TriggerStateChange: RBM_Finished)
ADISS -> RBM: RBM_StopEvtRec(TriggerHandle, metadata)
RBM --> ADISS: RBM_Ok()
RBM --> ADISS: Callback(RBM_TriggerStateChange: RBM_Cancelled)
ADISS -> RBM: RBM_trigEvtRecOnADISS(listofPDUs, metadata, priority, preEventTime, timeOfActivation, TriggerHandle)
RBM --> ADISS: RBM_Ok()
ADISS -> RBM: RBM_trigEvtRecOff(timeOfDeactivation, postEventTime, TriggerHandle, euuid, callback, metadata)
RBM --> ADISS: RBM_Ok()
RBM --> ADISS: Callback(RBM_TriggerStateChange: RBM_PreEvent)
RBM --> ADISS: Callback(RBM_TriggerStateChange: RBM_PostEvent)
RBM --> ADISS: Callback(RBM_TriggerStateChange: RBM_Finished)
ADISS -> RBM: RBM_StopEvtRec(TriggerHandle, metadata)
RBM --> ADISS: RBM_Ok()
RBM --> ADISS: Callback(RBM_TriggerStateChange: RBM_Cancelled)
ADISS -> RBM: RBM_EnterStandby()
RBM --> ADISS: RBM_Ok()
RBM --> ADISS: Callback(RBM_StateChange:RBM_Standby)
ADISS -> RBM: RBM_GetNumberOfOngoingTriggers()
RBM --> ADISS: triggerCount()

