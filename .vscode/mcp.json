{
  "servers": {
    "etm": {
      "command": "uv",
      "args": [
        "--directory",
        "etm",
        "run",
        "etmmcpserver.py"
      ],
      "env": {
        "ETM_BASE_URL": "https://rb-alm-14-p.de.bosch.com/qm",
        "ETM_USERNAME": "dtm3kor",
        "ETM_PASSWORD": "Star@dust1980",
        "ETM_PROJECT_AREA": "CentralComputingRack (QM)", // optional, can also be set per-request in the prompt
        "ETM_VERIFY_SSL": "false", // Disable SSL verification for internal servers with self-signed certificates
      }
    }
  },
  "inputs": [
    {
      "type": "promptString",
      "id": "etm-password",
      "description": "ETM PASSWORD",
      "password": true
    },
    {
      "type": "promptString",
      "id": "etm-username",
      "description": "ETM Username",
      "password": false
    }
  ]
}
